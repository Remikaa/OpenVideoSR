# ==========================================
# Build output
# ==========================================
/build/
/cmake-build-*/
/out/
/bin/
/obj/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Makefile
build.ninja
.ninja_*
Testing/

# ==========================================
# Compiled binaries and libraries
# ==========================================
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe
*.pdb
*.ilk
*.exp
*.pch
*.gch
*.class

# ==========================================
# IDEs and editors
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# ==========================================
# Qt generated files
# ==========================================
moc_*.cpp
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
.qmlcache/

# ==========================================
# JavaScript / Chrome extension tooling
# ==========================================
extension/node_modules/
extension/dist/
extension/build/
extension/coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# Logs and temporary files
# ==========================================
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# AI models and large media files
# ==========================================
# Keep model documentation and metadata tracked.
# Ignore downloaded model weights.
models/**/*.onnx
models/**/*.pt
models/**/*.pth
models/**/*.safetensors
models/**/*.engine
models/**/*.weights

# Ignore local test media and generated output.
test-output/
output/
captures/
recordings/

# ==========================================
# Local configuration and secrets
# ==========================================
.env
.env.*
!.env.example

# Local application settings
config.local.*
settings.local.*
# The app's local config copy holds the auth token (Structure.md 4.3).
config/local.json

# ==========================================
# Python tooling (if used for experiments)
# ==========================================
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
